# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Signing key for session tokens (auto-generated in-memory if unset).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional pre-configured admin bootstrap passcode.
# If left empty, the first visit to /admin/login presents a secure one-time admin setup form.
ADMIN_PASSCODE=

# VITE_API_BASE_URL: Optional backend API base URL (defaults to /api on same origin, or http://localhost:8080/api for standalone Spring Boot).
VITE_API_BASE_URL=
